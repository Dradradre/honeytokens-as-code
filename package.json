{
  "name": "honeytoken-mcp",
  "version": "0.3.0",
  "description": "Plant context-aware honeytokens in your repo through your coding agent, and get alerted when they are used.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "default": "./dist/notify/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "honeytoken": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "node src/cli.ts",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "honeytoken",
    "canary-token",
    "deception",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "agent-skill",
    "security"
  ]
}
