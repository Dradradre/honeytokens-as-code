{
  "name": "honeytokens-as-code",
  "version": "0.5.0",
  "description": "Your coding agent plants honeytokens in your repos: real, powerless AWS keys and internal-looking webhook traps, tracked, checked and rotated. Not a canary that watches your agent.",
  "license": "MIT",
  "author": "Dradradre",
  "homepage": "https://github.com/Dradradre/honeytokens-as-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dradradre/honeytokens-as-code.git"
  },
  "bugs": {
    "url": "https://github.com/Dradradre/honeytokens-as-code/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "default": "./dist/notify/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "honeytoken": "dist/cli.js",
    "honeytokens-as-code": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev": "node src/cli.ts",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "honeytoken",
    "canary-token",
    "deception",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "agent-skill",
    "security"
  ]
}
